<mujoco model="ur5e scene">
  <include file="ur5e.xml"/>

  <statistic center="0.3 0 0.4" extent="1.2"/>

  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicit">
    <flag contact="enable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.1 0.1 0.1"
               specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox"
             builtin="gradient"
             rgb1="0.3 0.5 0.7"
             rgb2="0 0 0"
             width="512"
             height="3072"/>

    <texture type="2d"
             name="groundplane"
             builtin="checker"
             mark="edge"
             rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300"
             height="300"/>

    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>

    <material name="amazon_cardboard"
              rgba="0.72 0.45 0.20 1"/>

    <material name="goal_green"
              rgba="0.1 1.0 0.1 0.35"/>
  </asset>

  <default>
    <default class="pushable_box">
      <geom type="box"
            material="amazon_cardboard"
            density="250"
            friction="1.2 0.1 0.01"
            solref="0.005 1"
            solimp="0.95 0.99 0.001"
            contype="1"
            conaffinity="1"
            condim="3"/>
      <joint type="free"
             damping="0.01"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5"
           dir="0 0 -1"
           directional="true"/>

    <geom name="floor"
          size="0 0 0.05"
          type="plane"
          material="groundplane"
          contype="1"
          conaffinity="1"
          friction="1.0 0.1 0.01"/>


    <!-- Target / candidate boxes.
         These names must match BOXES in teleop_collector.py. -->

  </worldbody>
</mujoco>
